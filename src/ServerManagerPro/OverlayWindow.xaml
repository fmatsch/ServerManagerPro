<Window x:Class="ServerManagerPro.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ServerManagerPro Overlay" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" Focusable="False" FontFamily="Segoe UI" UseLayoutRounding="True">
    <Border x:Name="Frame" Background="#E00B121A" CornerRadius="10" Padding="12,8" BorderThickness="1" BorderBrush="#33FFFFFF">
        <StackPanel x:Name="Rows" Grid.IsSharedSizeScope="True"/>
    </Border>
</Window>
