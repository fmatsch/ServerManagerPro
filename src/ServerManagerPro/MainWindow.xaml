<Window x:Class="ServerManagerPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ServerManagerPro.Controls"
        Title="ServerManagerPro" Width="1240" Height="800" MinWidth="560" MinHeight="420" AutomationProperties.Name="ServerManagerPro"
        Background="{StaticResource Bg}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <DockPanel MinWidth="0">
                    <Image DockPanel.Dock="Left" Source="app.ico" Width="40" Height="40" Margin="0,0,14,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HostText" FontSize="18" FontWeight="SemiBold" Text="…" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="OsText" Style="{StaticResource Muted}" Text="…" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateButton" Content="Update" Click="OnUpdateClick" Visibility="Collapsed" Background="#1F4150"/>
                    <Button x:Name="AdminButton" Content="Als Administrator starten" Click="OnElevate" Visibility="Collapsed"
                            ToolTip="Für Dienste steuern, SMB-Clients und SQL-Leistungsindikatoren sind Administratorrechte nötig."/>
                    <Button x:Name="OverlayBtn" Content="Overlay" Click="OnOverlayToggle" ToolTip="Kennzahlen als dauerhaftes Overlay anzeigen (Strg+Alt+O)"/>
                    <Button x:Name="RefreshBtn" Content="Aktualisieren" Click="OnRefresh"/>
                    <Border x:Name="StatusPill" Background="{StaticResource Panel2}" CornerRadius="10" Padding="16,6" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="OverallDot" Style="{StaticResource Dot}" Width="14" Height="14" Fill="Gray" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock x:Name="OverallText" FontWeight="SemiBold" FontSize="14" Text="Prüfe …"/>
                                <TextBlock x:Name="ScoreText" Style="{StaticResource Muted}" FontSize="11" Text=""/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavCol" Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <ListBox x:Name="Nav" AutomationProperties.Name="Navigation" Background="Transparent" BorderThickness="0" Margin="12,14,6,12"
                     ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="OnNav" SelectedIndex="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBoxItem Content="Übersicht" Tag="PageOverview"/>
                <ListBoxItem Content="Leistung" Tag="PagePerf"/>
                <ListBoxItem Content="Prozesse" Tag="PageProcs"/>
                <ListBoxItem Content="Dienste" Tag="PageServices"/>
                <ListBoxItem Content="Datenbanken" Tag="PageDb"/>
                <ListBoxItem Content="Sicherung" Tag="PageBackup"/>
                <ListBoxItem Content="Clients" Tag="PageClients"/>
                <ListBoxItem Content="Netzwerk" Tag="PageNet"/>
                <ListBoxItem Content="Sicherheit &amp; Rollen" Tag="PageDetails"/>
                <ListBoxItem x:Name="NavAd" Content="Active Directory" Tag="PageAd" Visibility="Collapsed"/>
                <ListBoxItem x:Name="NavDhcp" Content="DHCP &amp; IPs" Tag="PageDhcp" Visibility="Collapsed"/>
                <ListBoxItem x:Name="NavServers" Content="Server" Tag="PageServers" Visibility="Collapsed"/>
                <ListBoxItem Content="Ereignisse" Tag="PageEvents"/>
                <ListBoxItem Content="Alarme &amp; Zugriff" Tag="PageAlerts"/>
                <ListBoxItem Content="Einstellungen" Tag="PageSettings"/>
            </ListBox>

            <DockPanel Grid.Column="1" Margin="6,14,16,12">
                <ComboBox x:Name="NavPick" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,10" AutomationProperties.Name="Seite wählen" SelectionChanged="OnNavPick" DropDownOpened="OnNavPickOpened"/>
                <Grid>

                <!-- 0: Übersicht -->
                <ScrollViewer x:Name="PageOverview" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <UniformGrid x:Name="Tiles" Columns="4">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Prozessor" Style="{StaticResource Muted}"/>
                                    <TextBlock x:Name="TileCpu" FontSize="26" FontWeight="SemiBold" Text="–"/>
                                    <c:Sparkline x:Name="TileCpuGraph" AutomationProperties.Name="CPU-Verlauf" Height="44" Stroke="{x:Static c:Palette.Accent}" MaxValue="100" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Arbeitsspeicher" Style="{StaticResource Muted}"/>
                                    <TextBlock x:Name="TileMem" FontSize="26" FontWeight="SemiBold" Text="–"/>
                                    <c:Sparkline x:Name="TileMemGraph" AutomationProperties.Name="Speicher-Verlauf" Height="44" Stroke="{x:Static c:Palette.Violet}" MaxValue="100" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Datenträger" Style="{StaticResource Muted}"/>
                                    <TextBlock x:Name="TileDisk" FontSize="26" FontWeight="SemiBold" Text="–"/>
                                    <c:Sparkline x:Name="TileDiskGraph" AutomationProperties.Name="Datenträger-Verlauf" Height="44" Stroke="{x:Static c:Palette.Ok}" MaxValue="100" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Netzwerk" Style="{StaticResource Muted}"/>
                                    <TextBlock x:Name="TileNet" FontSize="26" FontWeight="SemiBold" Text="–"/>
                                    <c:Sparkline x:Name="TileNetGraph" AutomationProperties.Name="Netzwerk-Verlauf" Height="44" Stroke="{x:Static c:Palette.Orange}" MaxValue="0" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}">
                            <WrapPanel x:Name="Facts"/>
                        </Border>

                        <ItemsControl x:Name="Groups">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Ellipse Style="{StaticResource Dot}" Fill="{Binding Status, Converter={StaticResource HealthBrush}}" Margin="0,0,10,0" ToolTip="{Binding Status, Converter={StaticResource HealthLabel}}" AutomationProperties.Name="{Binding Status, Converter={StaticResource HealthLabel}}"/>
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="22"/>
                                                                <ColumnDefinition Width="200"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse Style="{StaticResource Dot}" Width="8" Height="8" HorizontalAlignment="Left"
                                                                     Fill="{Binding Status, Converter={StaticResource HealthBrush}}" ToolTip="{Binding Status, Converter={StaticResource HealthLabel}}" AutomationProperties.Name="{Binding Status, Converter={StaticResource HealthLabel}}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- 1: Leistung -->
                <ScrollViewer x:Name="PagePerf" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <UniformGrid x:Name="PerfGrid" Columns="2">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel><TextBlock Text="CPU" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="PerfCpuText" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
                                    <c:Sparkline x:Name="PerfCpuGraph" AutomationProperties.Name="CPU-Verlauf" Height="130" Stroke="{x:Static c:Palette.Accent}" MaxValue="100" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="PerfCpuSub" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel><TextBlock Text="Arbeitsspeicher" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="PerfMemText" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
                                    <c:Sparkline x:Name="PerfMemGraph" AutomationProperties.Name="Speicher-Verlauf" Height="130" Stroke="{x:Static c:Palette.Violet}" MaxValue="100" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="PerfMemSub" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel><TextBlock Text="Datenträger-Aktivität" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="PerfDiskText" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
                                    <c:Sparkline x:Name="PerfDiskGraph" AutomationProperties.Name="Datenträger-Verlauf" Height="130" Stroke="{x:Static c:Palette.Ok}" MaxValue="100" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="PerfDiskSub" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel><TextBlock Text="Netzwerk" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="PerfNetText" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
                                    <c:Sparkline x:Name="PerfNetGraph" AutomationProperties.Name="Netzwerk-Verlauf" Height="130" Stroke="{x:Static c:Palette.Orange}" MaxValue="0" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="PerfNetSub" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Logische Prozessoren" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="CoreList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,10,8" Width="104">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="11"/>
                                                <ProgressBar AutomationProperties.Name="{Binding Label}" Value="{Binding Value}" Maximum="100" Height="8" Background="#0E1620" BorderThickness="0"
                                                             Foreground="{Binding Value, Converter={StaticResource PctBrush}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Laufwerke" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="DiskList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="260"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <ProgressBar Grid.Column="1" Value="{Binding UsedPct, Mode=OneWay}" Maximum="100" Height="12" Background="#0E1620" BorderThickness="0"
                                                             Foreground="{Binding UsedPct, Converter={StaticResource PctBrush}}"/>
                                                <TextBlock Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource Muted}">
                                                    <Run Text="{Binding FreeGb, Mode=OneWay, StringFormat={}{0:0.#}}"/><Run Text=" GB frei von "/><Run Text="{Binding TotalGb, Mode=OneWay, StringFormat={}{0:0.#}}"/><Run Text=" GB"/>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2: Prozesse -->
                <DockPanel x:Name="PageProcs" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="ProcFilter" AutomationProperties.Name="Prozesse filtern" Width="260" TextChanged="OnProcFilter" Margin="0,0,10,0" ToolTip="Nach Name oder PID filtern"/>
                        <Button Content="Prozess beenden" Click="OnKillProcess"/>
                        <TextBlock x:Name="ProcInfo" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="ProcGrid" AutomationProperties.Name="Prozessliste">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80"/>
                            <DataGridTextColumn Header="CPU %" Binding="{Binding Cpu, StringFormat={}{0:0.0}}" Width="90"/>
                            <DataGridTextColumn Header="Speicher (MB)" Binding="{Binding MemMb, StringFormat={}{0:#,0.0}}" Width="130"/>
                            <DataGridTextColumn Header="Threads" Binding="{Binding Threads}" Width="90"/>
                            <DataGridTextColumn Header="Sitzung" Binding="{Binding Session}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- 3: Dienste -->
                <DockPanel x:Name="PageServices" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="SvcFilter" AutomationProperties.Name="Dienste filtern" Width="260" TextChanged="OnSvcFilter" Margin="0,0,10,0" ToolTip="Nach Name oder Anzeigename filtern"/>
                        <Button Content="Starten" Click="OnSvcStart"/>
                        <Button Content="Beenden" Click="OnSvcStop"/>
                        <Button Content="Neu starten" Click="OnSvcRestart"/>
                        <TextBlock x:Name="SvcInfo" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="SvcGrid" AutomationProperties.Name="Dienstliste">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Anzeigename" Binding="{Binding DisplayName}" Width="2*"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.3*" MinWidth="90"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#8B9BAB"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Running">
                                                <Setter Property="Foreground" Value="#22C55E"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Starttyp" Binding="{Binding StartMode}" Width="90"/>
                            <DataGridTextColumn Header="Konto" Binding="{Binding Account}" Width="*"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
                            <DataGridTextColumn Header="Hinweis" Binding="{Binding Info}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- 4: Datenbanken -->
                <ScrollViewer x:Name="PageDb" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="DbEmpty" Style="{StaticResource Muted}" Margin="4,4,0,12" TextWrapping="Wrap"
                                   Text="Es wurde kein Datenbankserver gefunden. Erkannt werden SQL Server, PostgreSQL, MySQL/MariaDB, Oracle, MongoDB, Firebird und Redis; weitere Dienste lassen sich unter Einstellungen ergänzen."/>
                        <ItemsControl x:Name="DbList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource Dot}" Width="12" Height="12" Fill="{Binding Status, Converter={StaticResource HealthBrush}}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Engine}" FontSize="17" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Instance, StringFormat=' · {0}'}" FontSize="17" Style="{StaticResource Muted}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="22,4,0,10" TextWrapping="Wrap"/>
                                            <UniformGrid Columns="5" Margin="22,0,0,8">
                                                <StackPanel><TextBlock Text="Verbindungen" Style="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding Connections}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                                                <StackPanel><TextBlock Text="Client-Rechner" Style="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding ClientHosts}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                                                <StackPanel><TextBlock Text="CPU %" Style="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding Cpu, StringFormat={}{0:0.0}}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                                                <StackPanel><TextBlock Text="Speicher MB" Style="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding MemMb, StringFormat={}{0:#,0}}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                                                <StackPanel><TextBlock Text="Ports" Style="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding Ports}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                                            </UniformGrid>
                                            <ItemsControl ItemsSource="{Binding Metrics}" Margin="22,0,0,8">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Key}" Style="{StaticResource Muted}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <DataGrid ItemsSource="{Binding Databases}" MaxHeight="260" Margin="22,4,0,0"
                                                      Visibility="{Binding Databases.Count, Converter={StaticResource CountVis}}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Datenbank" Binding="{Binding Name}" Width="*"/>
                                                    <DataGridTextColumn Header="Daten (MB)" Binding="{Binding DataMb, StringFormat={}{0:#,0.0}}" Width="110"/>
                                                    <DataGridTextColumn Header="Log (MB)" Binding="{Binding LogMb, StringFormat={}{0:#,0.0}}" Width="110"/>
                                                    <DataGridTextColumn Header="Aktive Transaktionen" Binding="{Binding ActiveTransactions}" Width="150"/>
                                                    <DataGridTextColumn Header="Transaktionen/s" Binding="{Binding TransactionsPerSec, StringFormat={}{0:0.0}}" Width="130"/>
                                                    <DataGridTextColumn Header="Sicherung KB/s" Binding="{Binding BackupThroughput, StringFormat={}{0:#,0}}" Width="130"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- 5: Sicherung -->
                <ScrollViewer x:Name="PageBackup" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="BackupDot" Style="{StaticResource Dot}" Width="16" Height="16" Fill="Gray" Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock x:Name="BackupHead" FontSize="18" FontWeight="SemiBold" Text="…"/>
                                    <TextBlock x:Name="BackupSub" Style="{StaticResource Muted}" Text=""/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Erkannte Sicherungslösungen" FontWeight="SemiBold" FontSize="15" Margin="2,4,0,8"/>
                        <DataGrid x:Name="BackupGrid" Margin="0,0,12,16" MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Lösung" Binding="{Binding Product}" Width="*"/>
                                <DataGridTextColumn Header="Quelle" Binding="{Binding Source}" Width="1.5*"/>
                                <DataGridTextColumn Header="Läuft" Binding="{Binding Running}" Width="70"/>
                                <DataGridTextColumn Header="Letzter Erfolg" Binding="{Binding LastSuccess, StringFormat=g}" Width="140"/>
                                <DataGridTextColumn Header="Letzter Fehler" Binding="{Binding LastFailure, StringFormat=g}" Width="140"/>
                                <DataGridTextColumn Header="Hinweis" Binding="{Binding Detail}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Geplante Sicherungsaufgaben" FontWeight="SemiBold" FontSize="15" Margin="2,4,0,8"/>
                        <DataGrid x:Name="TaskGrid" Margin="0,0,12,16" MaxHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Aufgabe" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Pfad" Binding="{Binding Path}" Width="1.5*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="100"/>
                                <DataGridTextColumn Header="Letzter Lauf" Binding="{Binding LastRun, StringFormat=g}" Width="140"/>
                                <DataGridTextColumn Header="Ergebnis" Binding="{Binding LastResult}" Width="130"/>
                                <DataGridTextColumn Header="Nächster Lauf" Binding="{Binding NextRun, StringFormat=g}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- 6: Clients -->
                <DockPanel x:Name="PageClients" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                        <WrapPanel x:Name="ClientFacts"/>
                    </Border>
                    <DataGrid x:Name="ClientGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Art" Binding="{Binding Kind}" Width="170"/>
                            <DataGridTextColumn Header="Benutzer" Binding="{Binding User}" Width="*"/>
                            <DataGridTextColumn Header="Client" Binding="{Binding Client}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="120"/>
                            <DataGridTextColumn Header="Details" Binding="{Binding Info}" Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- Netzwerk -->
                <DockPanel x:Name="PageNet" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                        <StackPanel>
                            <WrapPanel x:Name="NetFacts"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="Anzeige:" VerticalAlignment="Center" Style="{StaticResource Muted}" Margin="0,0,8,0"/>
                                <ComboBox x:Name="NetMode" Width="260" SelectedIndex="0" SelectionChanged="OnNetMode">
                                    <ComboBoxItem Content="Getrennt: lokal (LAN) und Internet"/>
                                    <ComboBoxItem Content="Nur lokales Netz (LAN)"/>
                                    <ComboBoxItem Content="Nur Internet"/>
                                    <ComboBoxItem Content="Nur dieser Rechner (Loopback)"/>
                                    <ComboBoxItem Content="Lauschende Ports"/>
                                    <ComboBoxItem Content="Alle, unsortiert"/>
                                </ComboBox>
                                <TextBox x:Name="NetFilter" AutomationProperties.Name="Verbindungen filtern" Width="220" Margin="12,0,0,0" TextChanged="OnNetFilter" ToolTip="Nach Prozess, Adresse oder Port filtern"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="NetGrid" AutomationProperties.Name="Netzwerkverbindungen">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="#1F4150" Padding="12,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="{Binding ItemCount, StringFormat='  ({0})'}" Style="{StaticResource Muted}" FontSize="14"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Prozess" Binding="{Binding Process}" Width="1.2*"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
                            <DataGridTextColumn Header="Lokal" Binding="{Binding Local}" Width="1.5*"/>
                            <DataGridTextColumn Header="Gegenstelle" Binding="{Binding Remote}" Width="1.8*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StateText}" Width="120"/>
                            <DataGridTextColumn Header="Netz" Binding="{Binding ScopeText}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- Sicherheit & Rollen -->
                <ScrollViewer x:Name="PageDetails" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel x:Name="DetailPanel"/>
                </ScrollViewer>

                <!-- Active Directory -->
                <ScrollViewer x:Name="PageAd" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="AdDot" Style="{StaticResource Dot}" Width="14" Height="14" Fill="Gray" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="AdHead" FontSize="18" FontWeight="SemiBold" Text="Active Directory"/>
                                    <TextBlock x:Name="AdDemo" Text="  (Beispieldaten)" Foreground="#F59E0B" Visibility="Collapsed" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="AdSub" Style="{StaticResource Muted}" Margin="24,2,0,10" TextWrapping="Wrap"/>
                                <WrapPanel x:Name="AdFacts" Margin="24,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Dienste" FontWeight="SemiBold" FontSize="15" Margin="2,4,0,8"/>
                        <DataGrid x:Name="AdSvcGrid" Margin="0,0,12,16" MaxHeight="240">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Dienst" Binding="{Binding DisplayName}" Width="2*"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="120"/>
                                <DataGridTextColumn Header="Starttyp" Binding="{Binding StartMode}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Replikation" FontWeight="SemiBold" FontSize="15" Margin="2,4,0,8"/>
                        <DataGrid x:Name="AdReplGrid" Margin="0,0,12,16" MaxHeight="240">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Partner" Binding="{Binding Partner}" Width="*"/>
                                <DataGridTextColumn Header="Partition" Binding="{Binding Partition}" Width="2*"/>
                                <DataGridTextColumn Header="Letzte Synchronisierung" Binding="{Binding LastSuccess, StringFormat=g}" Width="170"/>
                                <DataGridTextColumn Header="Ergebnis" Binding="{Binding Result}" Width="110"/>
                                <DataGridTextColumn Header="Fehler in Folge" Binding="{Binding Failures}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Betriebsmaster (FSMO)" FontWeight="SemiBold" FontSize="15" Margin="2,4,0,8"/>
                        <DataGrid x:Name="AdFsmoGrid" Margin="0,0,12,16" MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Rolle" Binding="{Binding Key}" Width="*"/>
                                <DataGridTextColumn Header="Inhaber" Binding="{Binding Value}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- DHCP -->
                <DockPanel x:Name="PageDhcp" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="DhcpDot" Style="{StaticResource Dot}" Width="14" Height="14" Fill="Gray" Margin="0,0,10,0"/>
                                <TextBlock x:Name="DhcpHead" FontSize="18" FontWeight="SemiBold" Text="DHCP-Server"/>
                                <TextBlock x:Name="DhcpDemo" Text="  (Beispieldaten)" Foreground="#F59E0B" Visibility="Collapsed" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="DhcpSub" Style="{StaticResource Muted}" Margin="24,2,0,8" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="24,0,0,0">
                                <Button x:Name="ScanButton" Content="Netz jetzt scannen" Click="OnDhcpScan"/>
                                <TextBlock x:Name="ScanInfo" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <DataGrid x:Name="ScopeGrid" AutomationProperties.Name="DHCP-Bereiche" DockPanel.Dock="Top" MaxHeight="150" Margin="0,0,12,10" SelectionChanged="OnScopeSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Bereich" Binding="{Binding ScopeId}" Width="120"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.3*"/>
                            <DataGridTextColumn Header="Adressen" Binding="{Binding Range}" Width="2.2*" MinWidth="150"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="80"/>
                            <DataGridTextColumn Header="Gesamt" Binding="{Binding Total}" Width="65"/>
                            <DataGridTextColumn Header="Vergeben" Binding="{Binding Leased}" Width="75"/>
                            <DataGridTextColumn Header="Reserviert" Binding="{Binding Reserved}" Width="80"/>
                            <DataGridTextColumn Header="DHCP frei" Binding="{Binding ServerFree}" Width="80"/>
                            <DataGridTextColumn Header="Konflikte" Binding="{Binding Conflicts}" Width="75"/>
                            <DataGridTextColumn Header="Wirklich frei" Binding="{Binding ReallyFree}" Width="95"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Adressen:" VerticalAlignment="Center" Style="{StaticResource Muted}" Margin="0,0,8,0"/>
                        <ComboBox x:Name="IpMode" Width="220" SelectedIndex="0" SelectionChanged="OnIpFilter">
                            <ComboBoxItem Content="Alle"/>
                            <ComboBoxItem Content="Wirklich frei (vergebbar)"/>
                            <ComboBoxItem Content="Konflikte und abgelehnt"/>
                            <ComboBoxItem Content="Vergeben"/>
                            <ComboBoxItem Content="Reserviert"/>
                        </ComboBox>
                        <TextBox x:Name="IpFilter" AutomationProperties.Name="Adressen filtern" Width="200" Margin="12,0,0,0" TextChanged="OnIpFilterText" ToolTip="Nach IP, Name oder MAC filtern"/>
                    </StackPanel>
                    <DataGrid x:Name="IpGrid" AutomationProperties.Name="IP-Adressen">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="IP-Adresse" Binding="{Binding Ip}" Width="130"/>
                            <DataGridTemplateColumn Header="Status" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#E6EDF3"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Frei"><Setter Property="Foreground" Value="#22C55E"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Konflikt"><Setter Property="Foreground" Value="#F87171"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Abgelehnt"><Setter Property="Foreground" Value="#F59E0B"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Ausgeschlossen"><Setter Property="Foreground" Value="#8B9BAB"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Name" Binding="{Binding Host}" Width="*"/>
                            <DataGridTextColumn Header="MAC" Binding="{Binding Mac}" Width="150"/>
                            <DataGridTextColumn Header="Details" Binding="{Binding DetailText}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- Server (entfernte Server) -->
                <DockPanel x:Name="PageServers" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Übersicht über diesen Rechner und alle entfernten Server, die ihren Status-Zugriff eingeschaltet haben. Auswählen zeigt die Prüfungen des Servers."/>
                    <DataGrid x:Name="RemoteGrid" DockPanel.Dock="Top" MaxHeight="230" Margin="0,0,12,10" AutomationProperties.Name="Serverliste" SelectionChanged="OnRemoteSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Server" Binding="{Binding Name}" Width="1.2*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="130"/>
                            <DataGridTextColumn Header="Gesundheit" Binding="{Binding ScoreText}" Width="100"/>
                            <DataGridTextColumn Header="Stand" Binding="{Binding FetchedText}" Width="90"/>
                            <DataGridTextColumn Header="Auffälligkeiten" Binding="{Binding Problems}" Width="2.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <DataGrid x:Name="RemoteChecksGrid" AutomationProperties.Name="Prüfungen des Servers">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Kategorie" Binding="{Binding Category}" Width="1*"/>
                            <DataGridTextColumn Header="Prüfung" Binding="{Binding Name}" Width="1.5*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                            <DataGridTextColumn Header="Details" Binding="{Binding Detail}" Width="3*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- Alarme & Zugriff -->
                <ScrollViewer x:Name="PageAlerts" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Alarme – melden, wenn etwas kaputtgeht" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="Die App meldet Warnungen und kritische Probleme nach außen (Handy, Teams, Slack …). Es werden nur ausgehende Verbindungen aufgebaut. Ein Problem wird erst gemeldet, wenn es länger als die Verzögerung besteht; gemeldet wird auch, wenn es behoben ist. Die App muss dafür laufen (zum Beispiel als Overlay im Hintergrund)."/>
                                <CheckBox x:Name="AlEnabled" Content="Alarme einschalten" Checked="OnAlertChanged" Unchecked="OnAlertChanged"/>
                                <TextBlock Text="Ziele (eines pro Zeile)" FontWeight="SemiBold" Margin="0,6,0,4"/>
                                <TextBox x:Name="AlTargets" AcceptsReturn="True" Height="96" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" AutomationProperties.Name="Alarmziele"/>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,8" FontFamily="Consolas" FontSize="12"
                                           Text="ntfy|https://ntfy.sh/mein-geheimes-thema|Token (optional)&#10;teams|https://…Webhook-URL aus einem Teams-Workflow&#10;slack|https://hooks.slack.com/services/…&#10;telegram|BotToken|ChatId&#10;webhook|https://…  (sendet JSON)&#10;tray   (Sprechblase am Tray-Symbol dieses Rechners)"/>
                                <WrapPanel Margin="0,0,0,6">
                                    <TextBlock Text="Verzögerung (Min.)" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="AlDelay" Width="46"/>
                                    <TextBlock Text="Erinnerung alle (Std., 0 = nie)" VerticalAlignment="Center" Margin="18,0,6,0"/><TextBox x:Name="AlReminder" Width="46"/>
                                    <TextBlock Text="Höchstens pro Stunde" VerticalAlignment="Center" Margin="18,0,6,0"/><TextBox x:Name="AlMax" Width="46"/>
                                </WrapPanel>
                                <CheckBox x:Name="AlOnlyCrit" Content="Nur kritische Probleme melden"/>
                                <CheckBox x:Name="AlRecovery" Content="Auch melden, wenn ein Problem behoben ist"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Button Content="Testnachricht senden" Click="OnAlertTest"/>
                                    <TextBlock x:Name="AlResult" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Status-Zugriff (nur lesen)" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="Macht die Zusammenfassung dieses Rechners über HTTPS abrufbar, damit ihn andere Installationen und ein Browser sehen können. Es gibt nur lesenden Zugriff, nur mit Token, ohne Einstellungen und Zugangsdaten. Gedacht für ein VPN (Tailscale, WireGuard): Tragen Sie als Adresse die des VPN-Adapters ein, nicht 0.0.0.0. Die Windows-Firewall öffnet die App nicht von selbst."/>
                                <CheckBox x:Name="SvEnabled" Content="Status-Zugriff einschalten" Checked="OnServeChanged" Unchecked="OnServeChanged"/>
                                <WrapPanel Margin="0,4,0,6">
                                    <TextBlock Text="Adresse" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="SvBind" Width="130"/>
                                    <TextBlock Text="Port" VerticalAlignment="Center" Margin="18,0,6,0"/><TextBox x:Name="SvPort" Width="60"/>
                                    <Button Content="Neues Token" Margin="18,0,0,0" Click="OnNewToken"/>
                                </WrapPanel>
                                <TextBlock Text="Token" Style="{StaticResource Muted}" FontSize="11"/>
                                <TextBox x:Name="SvToken" IsReadOnly="True" FontFamily="Consolas" Margin="0,0,0,6" AutomationProperties.Name="Token"/>
                                <TextBlock Text="Fingerabdruck des Zertifikats (SHA-1)" Style="{StaticResource Muted}" FontSize="11"/>
                                <TextBox x:Name="SvThumb" IsReadOnly="True" FontFamily="Consolas" Margin="0,0,0,6" AutomationProperties.Name="Fingerabdruck"/>
                                <TextBlock Text="Adresse für den Abruf" Style="{StaticResource Muted}" FontSize="11"/>
                                <TextBox x:Name="SvUrl" IsReadOnly="True" FontFamily="Consolas" Margin="0,0,0,6" AutomationProperties.Name="Abruf-Adresse"/>
                                <TextBlock x:Name="SvError" Foreground="#F87171" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Entfernte Server überwachen" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Text="Trägt man hier Server ein, die ihren Status-Zugriff eingeschaltet haben, erscheinen sie auf der Seite „Server“; Alarme gelten dann auch für sie, samt Meldung, wenn ein Server nicht mehr antwortet."/>
                                <TextBox x:Name="SvRemote" AcceptsReturn="True" Height="80" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" AutomationProperties.Name="Entfernte Server"/>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0" FontFamily="Consolas" FontSize="12"
                                           Text="Name|https://100.64.0.12:8765|Token|Fingerabdruck (SHA-1 des Zertifikats, aus dem Status-Zugriff des Servers)"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Speichern" Click="OnAlertSave" Padding="22,8"/>
                            <TextBlock x:Name="AlSaveInfo" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Text="Letzte Alarme" FontWeight="SemiBold" FontSize="15" Margin="2,8,0,8"/>
                        <DataGrid x:Name="AlHistory" MaxHeight="300" Margin="0,0,12,16" AutomationProperties.Name="Letzte Alarme">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Zeit" Binding="{Binding Time, StringFormat=g}" Width="130"/>
                                <DataGridTextColumn Header="Quelle" Binding="{Binding Source}" Width="1*"/>
                                <DataGridTextColumn Header="Stufe" Binding="{Binding Level}" Width="90"/>
                                <DataGridTextColumn Header="Art" Binding="{Binding Event}" Width="110"/>
                                <DataGridTextColumn Header="Meldung" Binding="{Binding Text}" Width="2*"/>
                                <DataGridTextColumn Header="Ergebnis" Binding="{Binding Result}" Width="1.4*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- 7: Ereignisse -->
                <DockPanel x:Name="PageEvents" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,10"
                               Text="Fehler, kritische Ereignisse und Warnungen der letzten 24 Stunden (System und Anwendungen)."/>
                    <DataGrid x:Name="EventGrid" AutomationProperties.Name="Ereignisliste">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Zeit" Binding="{Binding Time, StringFormat=g}" Width="130"/>
                            <DataGridTextColumn Header="Stufe" Binding="{Binding Level}" Width="80"/>
                            <DataGridTextColumn Header="Protokoll" Binding="{Binding Log}" Width="90"/>
                            <DataGridTextColumn Header="Quelle" Binding="{Binding Source}" Width="190"/>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTemplateColumn Header="Meldung" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- 8: Einstellungen -->
                <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <WrapPanel>
                                <TextBlock Text="Sprache" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="LangBox" Width="170" SelectionChanged="OnLanguageChanged">
                                    <ComboBoxItem Content="Automatisch"/>
                                    <ComboBoxItem Content="Deutsch"/>
                                    <ComboBoxItem Content="English"/>
                                </ComboBox>
                                <CheckBox x:Name="UpdCheck" Margin="24,0,0,0" VerticalAlignment="Center" Content="Automatisch nach Updates suchen (GitHub, einmal täglich)" Checked="OnUpdateOptionChanged" Unchecked="OnUpdateOptionChanged"/>
                                <Button Content="Nach Updates suchen" Margin="12,0,0,0" Click="OnCheckUpdateNow"/>
                            </WrapPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Overlay – Kennzahlen dauerhaft im Blick" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,10"
                                           Text="Ein kleines Fenster über allem anderen, durch das man hindurchklickt – wie ein FPS-Overlay. Es nimmt nie den Fokus und liest nur vorhandene Messwerte. Ein/Aus: Strg+Alt+O, Hauptfenster: Strg+Alt+M, Tray-Symbol für Verschieben und Beenden."/>
                                <TextBlock Text="Angezeigte Kennzahlen" Margin="0,0,0,6"/>
                                <WrapPanel x:Name="OvMetrics" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                                    <TextBlock Text="Position" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ComboBox x:Name="OvCorner" Width="170" SelectionChanged="OnOverlayChanged">
                                        <ComboBoxItem Content="Oben rechts"/>
                                        <ComboBoxItem Content="Oben links"/>
                                        <ComboBoxItem Content="Unten rechts"/>
                                        <ComboBoxItem Content="Unten links"/>
                                        <ComboBoxItem Content="Frei verschoben"/>
                                    </ComboBox>
                                    <TextBlock Text="Bildschirm" VerticalAlignment="Center" Margin="18,0,8,0"/>
                                    <ComboBox x:Name="OvMonitor" Width="190" SelectionChanged="OnOverlayChanged"/>
                                    <TextBlock Text="Anordnung" VerticalAlignment="Center" Margin="18,0,8,0"/>
                                    <ComboBox x:Name="OvLayout" Width="150" SelectionChanged="OnOverlayChanged">
                                        <ComboBoxItem Content="Untereinander"/>
                                        <ComboBoxItem Content="Leiste (in einer Zeile)"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="Deckkraft" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Slider x:Name="OvOpacity" Width="140" Minimum="30" Maximum="100" ValueChanged="OnOverlaySlider" VerticalAlignment="Center"/>
                                    <TextBlock Text="Schriftgröße" VerticalAlignment="Center" Margin="22,0,8,0"/>
                                    <Slider x:Name="OvFont" Width="140" Minimum="10" Maximum="24" ValueChanged="OnOverlaySlider" VerticalAlignment="Center"/>
                                </StackPanel>
                                <CheckBox x:Name="OvOnStart" Content="Overlay beim Programmstart anzeigen" Checked="OnOverlayChanged" Unchecked="OnOverlayChanged"/>
                                <CheckBox x:Name="OvAutostart" Content="Mit Windows starten (nur Overlay, im Hintergrund)" Checked="OnAutostartChanged" Unchecked="OnAutostartChanged"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Button Content="Overlay ein/aus" Click="OnOverlayToggle"/>
                                    <Button Content="Overlay verschieben" Click="OnOverlayMove" ToolTip="Danach das Overlay mit der Maus ziehen und loslassen"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Schwellenwerte" FontWeight="SemiBold" FontSize="15" Grid.ColumnSpan="3" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Text="CPU Warnung / kritisch (%)" Margin="0,5"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="SCpuW" Width="50"/><TextBox x:Name="SCpuC" Width="50" Margin="6,0,0,0"/></StackPanel>
                                <TextBlock Grid.Row="2" Text="Arbeitsspeicher Warnung / kritisch (%)" Margin="0,5"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="SMemW" Width="50"/><TextBox x:Name="SMemC" Width="50" Margin="6,0,0,0"/></StackPanel>
                                <TextBlock Grid.Row="3" Text="Freier Platz Warnung / kritisch (%)" Margin="0,5"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="SDiskW" Width="50"/><TextBox x:Name="SDiskC" Width="50" Margin="6,0,0,0"/></StackPanel>
                                <TextBlock Grid.Row="4" Text="Maximales Alter der letzten Sicherung (Std.)" Margin="0,5"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="SBackup" Width="50" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Row="5" Text="Ereignisse (Fehler/24 h) Warnung / kritisch" Margin="0,5"/>
                                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="SEvW" Width="50"/><TextBox x:Name="SEvC" Width="50" Margin="6,0,0,0"/></StackPanel>
                                <TextBlock Grid.Row="6" Text="Aktualisierung (Sekunden)" Margin="0,5"/>
                                <TextBox Grid.Row="6" Grid.Column="1" x:Name="SRefresh" Width="50" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Überwachte Dienste (einer pro Zeile – müssen immer laufen)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="SWatched" AcceptsReturn="True" Height="80" VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Text="Weitere Datenbank-Dienste (Muster mit * erlaubt, einer pro Zeile)" FontWeight="SemiBold" Margin="0,12,0,6"/>
                                <TextBox x:Name="SDbExtra" AcceptsReturn="True" Height="60" VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Text="Datenbank-Verbindungen für Detailwerte (einer pro Zeile)" FontWeight="SemiBold" Margin="0,12,0,2"/>
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="Format: postgresql|Dienstname-Teil|Host=localhost;Username=monitor;Password=…   oder   mysql||Server=localhost;User ID=monitor;Password=…   – am besten ein Benutzer nur mit Leserechten. Wird verschlüsselt (Windows-DPAPI) gespeichert."/>
                                <TextBox x:Name="SDbConn" AcceptsReturn="True" Height="60" VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Text="Weitere Stichwörter für Sicherungsaufgaben (einer pro Zeile)" FontWeight="SemiBold" Margin="0,12,0,6"/>
                                <TextBox x:Name="SBackupWords" AcceptsReturn="True" Height="60" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Speichern" Click="OnSaveSettings" Padding="22,8"/>
                            <Button Content="Bericht exportieren …" Click="OnExport" Padding="16,8"/>
                            <TextBlock x:Name="SettingsInfo" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
