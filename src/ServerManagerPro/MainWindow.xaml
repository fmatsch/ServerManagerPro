<Window x:Class="ServerManagerPro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ServerManagerPro.Controls"
        Title="ServerManagerPro" Width="1240" Height="800" MinWidth="980" MinHeight="620"
        Background="{StaticResource Bg}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" WindowStartupLocation="CenterScreen">
    <Grid Background="{StaticResource Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Kopfzeile -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Image Source="app.ico" Width="40" Height="40" Margin="0,0,14,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="HostText" FontSize="18" FontWeight="SemiBold" Text="…"/>
                        <TextBlock x:Name="OsText" Style="{StaticResource Muted}" Text="…"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AdminButton" Content="Als Administrator starten" Click="OnElevate" Visibility="Collapsed"
                            ToolTip="Für Dienste steuern, SMB-Clients und SQL-Leistungsindikatoren sind Administratorrechte nötig."/>
                    <Button Content="Aktualisieren" Click="OnRefresh"/>
                    <Border Background="{StaticResource Panel2}" CornerRadius="10" Padding="16,6" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="OverallDot" Style="{StaticResource Dot}" Width="14" Height="14" Fill="Gray" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock x:Name="OverallText" FontWeight="SemiBold" FontSize="14" Text="Prüfe …"/>
                                <TextBlock x:Name="ScoreText" Style="{StaticResource Muted}" FontSize="11" Text=""/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Navigation -->
            <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" Margin="12,14,6,12"
                     ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="OnNav" SelectedIndex="0">
                <ListBoxItem Content="Übersicht"/>
                <ListBoxItem Content="Leistung"/>
                <ListBoxItem Content="Prozesse"/>
                <ListBoxItem Content="Dienste"/>
                <ListBoxItem Content="Datenbanken"/>
                <ListBoxItem Content="Sicherung"/>
                <ListBoxItem Content="Clients"/>
                <ListBoxItem Content="Ereignisse"/>
                <ListBoxItem Content="Einstellungen"/>
            </ListBox>

            <Grid Grid.Column="1" Margin="6,14,16,12">

                <!-- 0: Übersicht -->
                <ScrollViewer x:Name="PageOverview" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <UniformGrid Columns="4">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Prozessor" Style="{StaticResource Muted}"/>
                                    <TextBlock x:Name="TileCpu" FontSize="26" FontWeight="SemiBold" Text="–"/>
                                    <c:Sparkline x:Name="TileCpuGraph" Height="44" Stroke="{x:Static c:Palette.Accent}" MaxValue="100" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Arbeitsspeicher" Style="{StaticResource Muted}"/>
                                    <TextBlock x:Name="TileMem" FontSize="26" FontWeight="SemiBold" Text="–"/>
                                    <c:Sparkline x:Name="TileMemGraph" Height="44" Stroke="{x:Static c:Palette.Violet}" MaxValue="100" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Datenträger" Style="{StaticResource Muted}"/>
                                    <TextBlock x:Name="TileDisk" FontSize="26" FontWeight="SemiBold" Text="–"/>
                                    <c:Sparkline x:Name="TileDiskGraph" Height="44" Stroke="{x:Static c:Palette.Ok}" MaxValue="100" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Netzwerk" Style="{StaticResource Muted}"/>
                                    <TextBlock x:Name="TileNet" FontSize="26" FontWeight="SemiBold" Text="–"/>
                                    <c:Sparkline x:Name="TileNetGraph" Height="44" Stroke="{x:Static c:Palette.Orange}" MaxValue="0" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}">
                            <WrapPanel x:Name="Facts"/>
                        </Border>

                        <ItemsControl x:Name="Groups">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <Ellipse Style="{StaticResource Dot}" Fill="{Binding Status, Converter={StaticResource HealthBrush}}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="22"/>
                                                                <ColumnDefinition Width="230"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse Style="{StaticResource Dot}" Width="8" Height="8" HorizontalAlignment="Left"
                                                                     Fill="{Binding Status, Converter={StaticResource HealthBrush}}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap" Style="{StaticResource Muted}"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- 1: Leistung -->
                <ScrollViewer x:Name="PagePerf" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <UniformGrid Columns="2">
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel><TextBlock Text="CPU" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="PerfCpuText" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
                                    <c:Sparkline x:Name="PerfCpuGraph" Height="130" Stroke="{x:Static c:Palette.Accent}" MaxValue="100" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="PerfCpuSub" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel><TextBlock Text="Arbeitsspeicher" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="PerfMemText" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
                                    <c:Sparkline x:Name="PerfMemGraph" Height="130" Stroke="{x:Static c:Palette.Violet}" MaxValue="100" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="PerfMemSub" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel><TextBlock Text="Datenträger-Aktivität" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="PerfDiskText" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
                                    <c:Sparkline x:Name="PerfDiskGraph" Height="130" Stroke="{x:Static c:Palette.Ok}" MaxValue="100" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="PerfDiskSub" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel><TextBlock Text="Netzwerk" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="PerfNetText" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
                                    <c:Sparkline x:Name="PerfNetGraph" Height="130" Stroke="{x:Static c:Palette.Orange}" MaxValue="0" Margin="0,8,0,0"/>
                                    <TextBlock x:Name="PerfNetSub" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Logische Prozessoren" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="CoreList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="8"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,10,8">
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" FontSize="11"/>
                                                <ProgressBar Value="{Binding Value}" Maximum="100" Height="8" Background="#0E1620" BorderThickness="0"
                                                             Foreground="{Binding Value, Converter={StaticResource PctBrush}}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Laufwerke" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                                <ItemsControl x:Name="DiskList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="260"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <ProgressBar Grid.Column="1" Value="{Binding UsedPct, Mode=OneWay}" Maximum="100" Height="12" Background="#0E1620" BorderThickness="0"
                                                             Foreground="{Binding UsedPct, Converter={StaticResource PctBrush}}"/>
                                                <TextBlock Grid.Column="2" Margin="12,0,0,0" Style="{StaticResource Muted}">
                                                    <Run Text="{Binding FreeGb, Mode=OneWay, StringFormat={}{0:0.#}}"/><Run Text=" GB frei von "/><Run Text="{Binding TotalGb, Mode=OneWay, StringFormat={}{0:0.#}}"/><Run Text=" GB"/>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2: Prozesse -->
                <DockPanel x:Name="PageProcs" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="ProcFilter" Width="260" TextChanged="OnProcFilter" Margin="0,0,10,0" ToolTip="Nach Name oder PID filtern"/>
                        <Button Content="Prozess beenden" Click="OnKillProcess"/>
                        <TextBlock x:Name="ProcInfo" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="ProcGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80"/>
                            <DataGridTextColumn Header="CPU %" Binding="{Binding Cpu, StringFormat={}{0:0.0}}" Width="90"/>
                            <DataGridTextColumn Header="Speicher (MB)" Binding="{Binding MemMb, StringFormat={}{0:#,0.0}}" Width="130"/>
                            <DataGridTextColumn Header="Threads" Binding="{Binding Threads}" Width="90"/>
                            <DataGridTextColumn Header="Sitzung" Binding="{Binding Session}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- 3: Dienste -->
                <DockPanel x:Name="PageServices" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox x:Name="SvcFilter" Width="260" TextChanged="OnSvcFilter" Margin="0,0,10,0" ToolTip="Nach Name oder Anzeigename filtern"/>
                        <Button Content="Starten" Click="OnSvcStart"/>
                        <Button Content="Beenden" Click="OnSvcStop"/>
                        <Button Content="Neu starten" Click="OnSvcRestart"/>
                        <TextBlock x:Name="SvcInfo" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <DataGrid x:Name="SvcGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Anzeigename" Binding="{Binding DisplayName}" Width="2*"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="1.3*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#8B9BAB"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding State}" Value="Running">
                                                <Setter Property="Foreground" Value="#22C55E"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Starttyp" Binding="{Binding StartMode}" Width="90"/>
                            <DataGridTextColumn Header="Konto" Binding="{Binding Account}" Width="*"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70"/>
                            <DataGridTextColumn Header="Hinweis" Binding="{Binding Info}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- 4: Datenbanken -->
                <ScrollViewer x:Name="PageDb" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="DbEmpty" Style="{StaticResource Muted}" Margin="4,4,0,12" TextWrapping="Wrap"
                                   Text="Es wurde kein Datenbankserver gefunden. Erkannt werden SQL Server, PostgreSQL, MySQL/MariaDB, Oracle, MongoDB, Firebird und Redis; weitere Dienste lassen sich unter Einstellungen ergänzen."/>
                        <ItemsControl x:Name="DbList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource Dot}" Width="12" Height="12" Fill="{Binding Status, Converter={StaticResource HealthBrush}}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding Engine}" FontSize="17" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Instance, StringFormat=' · {0}'}" FontSize="17" Style="{StaticResource Muted}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="22,4,0,10" TextWrapping="Wrap"/>
                                            <UniformGrid Columns="5" Margin="22,0,0,8">
                                                <StackPanel><TextBlock Text="Verbindungen" Style="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding Connections}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                                                <StackPanel><TextBlock Text="Client-Rechner" Style="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding ClientHosts}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                                                <StackPanel><TextBlock Text="CPU %" Style="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding Cpu, StringFormat={}{0:0.0}}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                                                <StackPanel><TextBlock Text="Speicher MB" Style="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding MemMb, StringFormat={}{0:#,0}}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                                                <StackPanel><TextBlock Text="Ports" Style="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{Binding Ports}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                                            </UniformGrid>
                                            <ItemsControl ItemsSource="{Binding Metrics}" Margin="22,0,0,8">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,2">
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Key}" Style="{StaticResource Muted}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap"/>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <DataGrid ItemsSource="{Binding Databases}" MaxHeight="260" Margin="22,4,0,0"
                                                      Visibility="{Binding Databases.Count, Converter={StaticResource CountVis}}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Datenbank" Binding="{Binding Name}" Width="*"/>
                                                    <DataGridTextColumn Header="Daten (MB)" Binding="{Binding DataMb, StringFormat={}{0:#,0.0}}" Width="110"/>
                                                    <DataGridTextColumn Header="Log (MB)" Binding="{Binding LogMb, StringFormat={}{0:#,0.0}}" Width="110"/>
                                                    <DataGridTextColumn Header="Aktive Transaktionen" Binding="{Binding ActiveTransactions}" Width="150"/>
                                                    <DataGridTextColumn Header="Transaktionen/s" Binding="{Binding TransactionsPerSec, StringFormat={}{0:0.0}}" Width="130"/>
                                                    <DataGridTextColumn Header="Sicherung KB/s" Binding="{Binding BackupThroughput, StringFormat={}{0:#,0}}" Width="130"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- 5: Sicherung -->
                <ScrollViewer x:Name="PageBackup" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="BackupDot" Style="{StaticResource Dot}" Width="16" Height="16" Fill="Gray" Margin="0,0,12,0"/>
                                <StackPanel>
                                    <TextBlock x:Name="BackupHead" FontSize="18" FontWeight="SemiBold" Text="…"/>
                                    <TextBlock x:Name="BackupSub" Style="{StaticResource Muted}" Text=""/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Erkannte Sicherungslösungen" FontWeight="SemiBold" FontSize="15" Margin="2,4,0,8"/>
                        <DataGrid x:Name="BackupGrid" Margin="0,0,12,16" MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Lösung" Binding="{Binding Product}" Width="*"/>
                                <DataGridTextColumn Header="Quelle" Binding="{Binding Source}" Width="1.5*"/>
                                <DataGridTextColumn Header="Läuft" Binding="{Binding Running}" Width="70"/>
                                <DataGridTextColumn Header="Letzter Erfolg" Binding="{Binding LastSuccess, StringFormat=g}" Width="140"/>
                                <DataGridTextColumn Header="Letzter Fehler" Binding="{Binding LastFailure, StringFormat=g}" Width="140"/>
                                <DataGridTextColumn Header="Hinweis" Binding="{Binding Detail}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Geplante Sicherungsaufgaben" FontWeight="SemiBold" FontSize="15" Margin="2,4,0,8"/>
                        <DataGrid x:Name="TaskGrid" Margin="0,0,12,16" MaxHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Aufgabe" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Pfad" Binding="{Binding Path}" Width="1.5*"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="100"/>
                                <DataGridTextColumn Header="Letzter Lauf" Binding="{Binding LastRun, StringFormat=g}" Width="140"/>
                                <DataGridTextColumn Header="Ergebnis" Binding="{Binding LastResult}" Width="130"/>
                                <DataGridTextColumn Header="Nächster Lauf" Binding="{Binding NextRun, StringFormat=g}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>

                <!-- 6: Clients -->
                <DockPanel x:Name="PageClients" Visibility="Collapsed">
                    <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                        <WrapPanel x:Name="ClientFacts"/>
                    </Border>
                    <DataGrid x:Name="ClientGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Art" Binding="{Binding Kind}" Width="170"/>
                            <DataGridTextColumn Header="Benutzer" Binding="{Binding User}" Width="*"/>
                            <DataGridTextColumn Header="Client" Binding="{Binding Client}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="120"/>
                            <DataGridTextColumn Header="Details" Binding="{Binding Info}" Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- 7: Ereignisse -->
                <DockPanel x:Name="PageEvents" Visibility="Collapsed">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,10"
                               Text="Fehler, kritische Ereignisse und Warnungen der letzten 24 Stunden (System und Anwendungen)."/>
                    <DataGrid x:Name="EventGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Zeit" Binding="{Binding Time, StringFormat=g}" Width="130"/>
                            <DataGridTextColumn Header="Stufe" Binding="{Binding Level}" Width="80"/>
                            <DataGridTextColumn Header="Protokoll" Binding="{Binding Log}" Width="90"/>
                            <DataGridTextColumn Header="Quelle" Binding="{Binding Source}" Width="190"/>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTemplateColumn Header="Meldung" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>

                <!-- 8: Einstellungen -->
                <ScrollViewer x:Name="PageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Schwellenwerte" FontWeight="SemiBold" FontSize="15" Grid.ColumnSpan="3" Margin="0,0,0,8"/>
                                <TextBlock Grid.Row="1" Text="CPU Warnung / kritisch (%)" Margin="0,5"/>
                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="SCpuW" Width="50"/><TextBox x:Name="SCpuC" Width="50" Margin="6,0,0,0"/></StackPanel>
                                <TextBlock Grid.Row="2" Text="Arbeitsspeicher Warnung / kritisch (%)" Margin="0,5"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="SMemW" Width="50"/><TextBox x:Name="SMemC" Width="50" Margin="6,0,0,0"/></StackPanel>
                                <TextBlock Grid.Row="3" Text="Freier Platz Warnung / kritisch (%)" Margin="0,5"/>
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="SDiskW" Width="50"/><TextBox x:Name="SDiskC" Width="50" Margin="6,0,0,0"/></StackPanel>
                                <TextBlock Grid.Row="4" Text="Maximales Alter der letzten Sicherung (Std.)" Margin="0,5"/>
                                <TextBox Grid.Row="4" Grid.Column="1" x:Name="SBackup" Width="50" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Row="5" Text="Ereignisse (Fehler/24 h) Warnung / kritisch" Margin="0,5"/>
                                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal"><TextBox x:Name="SEvW" Width="50"/><TextBox x:Name="SEvC" Width="50" Margin="6,0,0,0"/></StackPanel>
                                <TextBlock Grid.Row="6" Text="Aktualisierung (Sekunden)" Margin="0,5"/>
                                <TextBox Grid.Row="6" Grid.Column="1" x:Name="SRefresh" Width="50" HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Überwachte Dienste (einer pro Zeile – müssen immer laufen)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox x:Name="SWatched" AcceptsReturn="True" Height="80" VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Text="Weitere Datenbank-Dienste (Muster mit * erlaubt, einer pro Zeile)" FontWeight="SemiBold" Margin="0,12,0,6"/>
                                <TextBox x:Name="SDbExtra" AcceptsReturn="True" Height="60" VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Text="Weitere Stichwörter für Sicherungsaufgaben (einer pro Zeile)" FontWeight="SemiBold" Margin="0,12,0,6"/>
                                <TextBox x:Name="SBackupWords" AcceptsReturn="True" Height="60" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Speichern" Click="OnSaveSettings" Padding="22,8"/>
                            <Button Content="Bericht exportieren …" Click="OnExport" Padding="16,8"/>
                            <TextBlock x:Name="SettingsInfo" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
